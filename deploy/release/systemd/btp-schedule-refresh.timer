# Daily at 03:30 Europe/Berlin plus up to 15 min; a run missed while the server was off
# runs at the next boot (Persistent). Installed by deploy/release/deploy.sh (ADR-0011).
[Unit]
Description=btp: daily static GTFS refresh

[Timer]
OnCalendar=*-*-* 03:30:00 Europe/Berlin
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
