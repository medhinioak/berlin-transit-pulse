# Postgres passwords for the compose stack. Copy to deploy/compose/.env to override.
# These are the dev defaults compose already uses; not secrets. M2 replaces them.
# Roles are created on first start only: after changing one, reset with `down -v`.
BTP_PG_SUPERUSER_PASSWORD=dev_superuser
BTP_PG_PROCESSOR_PASSWORD=dev_processor
BTP_PG_SCHEDULE_PASSWORD=dev_schedule
BTP_PG_METRICS_JOBS_PASSWORD=dev_metrics_jobs
BTP_PG_API_PASSWORD=dev_api

# live (default) downloads the VBB static GTFS; fixtures uses fixtures/ and needs no network.
# BTP_FEED_MODE=fixtures
