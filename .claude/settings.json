{
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make typecheck)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git push -u origin feat/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push -u origin docs/:*)",
      "Bash(git push -u origin ci/:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(git push -u origin test/:*)",
      "Bash(git push -u origin refactor/:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(aws:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Read(./.env*)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.tfstate*)",
      "Read(~/.aws/**)"
    ]
  }
}
